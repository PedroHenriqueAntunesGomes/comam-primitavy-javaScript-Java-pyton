console.log(typeof semValor); // Resultado: "undefined"

// 8. Null (Vazio intencional)
const valorVazio = null;
console.log(valorVazio); // Resultado: null
// OBS: por um erro histórico do JavaScript, o typeof do null retorna "object"
console.log(typeof valorVazio); // Resultado: "object"

//9. Symbol (Identificador Unico);
const meuSimbolo = Symbol("id");
console.log(meuSimbolo); // Resultado: Symbol(id)
console.log(typeof meuSimbolo); // Resultado: "symbol"
